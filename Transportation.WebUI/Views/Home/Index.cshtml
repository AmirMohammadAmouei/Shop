@using Transportation.Buisness.Services.AboutUs.Dtos
@model HomeViewModel

<section class="hero">
    <div class="hero-scene">
        <svg viewBox="0 0 700 480" preserveAspectRatio="xMaxYMax meet" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="roadGlow" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#2f7dfa" stop-opacity="0" />
                    <stop offset="100%" stop-color="#5aa2ff" stop-opacity=".9" />
                </linearGradient>
                <radialGradient id="pinGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#5aa2ff" stop-opacity=".55" />
                    <stop offset="100%" stop-color="#5aa2ff" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="headlight" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#fff5cf" stop-opacity=".95" />
                    <stop offset="100%" stop-color="#fff5cf" stop-opacity="0" />
                </radialGradient>
            </defs>

            <!-- city skyline -->
            <g opacity=".5" fill="#0e2454">
                <rect x="430" y="190" width="30" height="180" />
                <rect x="466" y="160" width="24" height="210" />
                <rect x="496" y="215" width="26" height="155" />
                <rect x="528" y="130" width="20" height="240" />
                <rect x="554" y="180" width="30" height="190" />
                <rect x="590" y="150" width="22" height="220" />
                <rect x="616" y="200" width="26" height="170" />
                <rect x="648" y="115" width="18" height="255" />
                <rect x="670" y="165" width="24" height="205" />
            </g>

            <!-- road -->
            <polygon points="330,480 700,480 700,330 420,330" fill="#061530" />
            <polygon points="360,480 700,480 700,350 390,350" fill="url(#roadGlow)" opacity=".5" />
            <g stroke="#dbe6ff" stroke-width="3" stroke-dasharray="20 16" opacity=".55">
                <line x1="390" y1="480" x2="560" y2="336" />
            </g>
            <g stroke="#5aa2ff" stroke-width="2" opacity=".8">
                <line x1="330" y1="480" x2="420" y2="330" />
                <line x1="700" y1="480" x2="700" y2="330" />
            </g>

            <!-- truck silhouette -->
            <g transform="translate(355,225)">
                <ellipse cx="140" cy="248" rx="220" ry="13" fill="#000" opacity=".35" />
                <!-- trailer -->
                <rect x="150" y="70" width="220" height="135" rx="6" fill="#12233f" stroke="#2c4470" stroke-width="2" />
                <rect x="160" y="80" width="200" height="28" rx="3" fill="#1a2d52" />
                <!-- cab -->
                <path d="M20,138 L20,205 L150,205 L150,90 L95,90 C80,90 68,98 60,112 L20,138Z" fill="#233a63" stroke="#3a5486" stroke-width="2" />
                <path d="M35,138 L60,112 C66,102 76,96 90,96 L108,96 L108,138 Z" fill="#0f1c38" />
                <rect x="72" y="102" width="28" height="28" rx="3" fill="#6fb4ff" opacity=".5" />
                <!-- headlight -->
                <circle cx="14" cy="182" r="28" fill="url(#headlight)" />
                <circle cx="16" cy="182" r="7" fill="#fff5cf" />
                <!-- wheels -->
                <circle cx="70" cy="208" r="19" fill="#050b18" stroke="#3a5486" stroke-width="3" />
                <circle cx="248" cy="208" r="19" fill="#050b18" stroke="#3a5486" stroke-width="3" />
                <circle cx="310" cy="208" r="19" fill="#050b18" stroke="#3a5486" stroke-width="3" />
            </g>

            <!-- speed lines -->
            <g stroke="#5aa2ff" stroke-width="2" opacity=".5" stroke-linecap="round">
                <line x1="330" y1="420" x2="400" y2="420" />
                <line x1="290" y1="445" x2="380" y2="445" />
                <line x1="360" y1="465" x2="460" y2="465" />
            </g>
        </svg>
    </div>
    <div class="hero-pin">
        <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <radialGradient id="pinGlow2" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#5aa2ff" stop-opacity=".55" />
                    <stop offset="100%" stop-color="#5aa2ff" stop-opacity="0" />
                </radialGradient>
            </defs>
            <g transform="translate(110,110)">
                <circle r="105" fill="url(#pinGlow2)" />
                <circle r="62" fill="none" stroke="#3f8bff" stroke-width="1" opacity=".35" />
                <circle r="94" fill="none" stroke="#3f8bff" stroke-width="1" opacity=".2" />
                <g stroke="#3f8bff" stroke-width="1" opacity=".5">
                    <line x1="0" y1="0" x2="-84" y2="28" />
                    <line x1="0" y1="0" x2="80" y2="38" />
                    <line x1="0" y1="0" x2="-48" y2="-62" />
                    <line x1="0" y1="0" x2="62" y2="-54" />
                </g>
                <g fill="#3f8bff" opacity=".8">
                    <circle cx="-84" cy="28" r="3" />
                    <circle cx="80" cy="38" r="3" />
                    <circle cx="-48" cy="-62" r="3" />
                    <circle cx="62" cy="-54" r="3" />
                </g>
                <path d="M0,-40C-19,-40 -35,-26 -35,-6C-35,21 0,51 0,51C0,51 35,21 35,-6C35,-26 19,-40 0,-40Z" fill="#2f7dfa" />
                <circle cx="0" cy="-7" r="12" fill="#01112a" />
            </g>
        </svg>
    </div>
    <div class="hero-fade"></div>
    <div class="wrap">
        <div class="hero-inner">
            <h1>سامانه کنترل هوشمند<span class="line2">ناوگان حمل و نقل</span></h1>
            <p>ارائه‌دهنده راهکارهای جامع سخت‌افزاری و نرم‌افزاری ردیابی و مدیریت ناوگان با تکیه بر فناوری روز دنیا برای افزایش بهره‌وری، کاهش هزینه‌ها و امنیت بیشتر.</p>
            <div class="hero-actions">
                <a href="#products" class="pill pill-solid">مشاهده محصولات</a>
                <a href="#about" class="pill pill-ghost-light">درباره ما</a>
            </div>
            <div class="hero-feats">
                <div class="hero-feat">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg></span>
                    <span><b>پشتیبانی ۲۴/۷</b><span>پاسخگوی شما هستیم</span></span>
                </div>
                <div class="hero-feat">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M3 16V8a1 1 0 0 1 1-1h9v9" /><path d="M13 10h4l3 3v3h-2" /><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" /></svg></span>
                    <span><b>نصب سریع</b><span>در سراسر کشور</span></span>
                </div>
                <div class="hero-feat">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2" /></svg></span>
                    <span><b>دقت بالا</b><span>موقعیت‌یابی دقیق</span></span>
                </div>
                <div class="hero-feat">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" /></svg></span>
                    <span><b>امنیت اطلاعات</b><span>استانداردهای روز دنیا</span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="about" id="about">
    <div class="wrap">
        <div class="about-media">
            @{
                var galleries = Model.AboutUs.Galleries ?? new List<AboutUsGalleriesResponseDto>();
            }

            @if (galleries.Any())
            {
                @* لایه بیرونی — برای دکمه‌ها *@
                <div style="position:relative; width:100%; height:440px; padding:0 22px;">

                    @* لایه داخلی — برای عکس‌ها با overflow:hidden *@
                    <div style="position:relative; width:100%; height:100%; border-radius:18px;
                        overflow:hidden; box-shadow:0 25px 55px rgba(10,20,60,.2);
                        border:5px solid #fff;">

                        @foreach (var img in galleries)
                        {
                            var idx = galleries.IndexOf(img);
                            <div class="about-slide" id="slide-@idx"
                                 style="position:absolute; inset:0; transition:opacity .4s ease;
                                opacity:@(idx == 0 ? "1" : "0");
                                pointer-events:@(idx == 0 ? "auto" : "none");">
                                <img src="/@img.Path.TrimStart('/')"
                                     style="width:100%;height:100%;object-fit:cover;">
                            </div>
                        }

                        @* دات‌ها داخل لایه داخلی *@
                        @if (galleries.Count > 1)
                        {
                            <div style="position:absolute;bottom:14px;left:50%;transform:translateX(-50%);
                                display:flex;gap:7px;z-index:10;">
                                @for (int i = 0; i < galleries.Count; i++)
                                {
                                    <div class="about-dot" id="dot-@i"
                                         onclick="goToAboutSlide(@i)"
                                         style="width:@(i == 0 ? "22px" : "8px");height:8px;border-radius:100px;
                                    background:@(i == 0 ? "var(--blue)" : "rgba(255,255,255,.5)");
                                    cursor:pointer;transition:.3s;"></div>
                                }
                            </div>
                        }

                    </div>

                    @* دکمه‌ها روی لایه بیرونی *@
                    @if (galleries.Count > 1)
                    {
                        <button onclick="aboutSlide(1)"
                                style="position:absolute;right:0;top:50%;transform:translateY(-50%);
                            z-index:10;width:38px;height:38px;border-radius:50%;
                            background:#fff;border:1px solid var(--line);cursor:pointer;
                            display:flex;align-items:center;justify-content:center;
                            box-shadow:0 2px 10px rgba(0,0,0,.12);font-size:18px;color:var(--navy);">
                            &#10094;
                        </button>
                        <button onclick="aboutSlide(-1)"
                                style="position:absolute;left:0;top:50%;transform:translateY(-50%);
                            z-index:10;width:38px;height:38px;border-radius:50%;
                            background:#fff;border:1px solid var(--line);cursor:pointer;
                            display:flex;align-items:center;justify-content:center;
                            box-shadow:0 2px 10px rgba(0,0,0,.12);font-size:18px;color:var(--navy);">
                                &#10095;
                        </button>
                    }

                </div>
            }
            else
            {
                <div class="m-earth">
                    <svg viewBox="0 0 400 300" fill="none">
                        <rect width="400" height="300" fill="#1a2a4a" />
                        <circle cx="200" cy="150" r="100" fill="none" stroke="#2a4a8a" stroke-width="1" />
                        <circle cx="200" cy="150" r="70" fill="none" stroke="#2a4a8a" stroke-width="1" />
                        <circle cx="200" cy="150" r="40" fill="none" stroke="#2a4a8a" stroke-width="1" />
                        <path d="M120 150 Q160 100 200 150 Q240 200 280 150" stroke="#3f8bff" stroke-width="1.5" fill="none" />
                        <circle cx="200" cy="150" r="6" fill="#3f8bff" />
                    </svg>
                </div>
                <div class="m-highway">
                    <svg viewBox="0 0 400 300" fill="none">
                        <rect width="400" height="300" fill="#0f1e38" />
                        <path d="M0 200 L400 150" stroke="#2a4a8a" stroke-width="60" />
                        <path d="M50 180 L150 165 M200 157 L300 145" stroke="white" stroke-width="3" stroke-dasharray="20 20" />
                        <rect x="150" y="100" width="60" height="40" rx="4" fill="#1e62c7" />
                    </svg>
                </div>
                <div class="m-dash">
                    <svg viewBox="0 0 600 200" fill="none">
                        <rect width="600" height="200" fill="#0e1a3a" />
                        <rect x="20" y="20" width="120" height="70" rx="6" fill="#1a2a5a" />
                        <rect x="30" y="30" width="100" height="10" rx="3" fill="#3f8bff" opacity=".4" />
                        <rect x="160" y="20" width="120" height="70" rx="6" fill="#1a2a5a" />
                        <circle cx="220" cy="55" r="22" fill="#0e1a3a" />
                        <path d="M210 55 L216 61 L230 47" stroke="#3f8bff" stroke-width="2.5" stroke-linecap="round" />
                        <rect x="20" y="110" width="400" height="70" rx="6" fill="#1a2a5a" />
                        <rect x="30" y="125" width="200" height="6" rx="3" fill="#3f8bff" opacity=".3" />
                        <rect x="30" y="140" width="150" height="6" rx="3" fill="#3f8bff" opacity=".2" />
                    </svg>
                </div>
            }
        </div>
        <div>
            <span class="eyebrow">درباره ما</span>
            <h2>@Model.AboutUs.Title</h2>
            <p>@Model.AboutUs.Description</p>
            <a href="tel:@Model.AboutUs.Phone" class="pill pill-solid">
                <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px;">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
                </svg>
                @Model.AboutUs.Phone
            </a>
        </div>
    </div>
</section>

<section class="products" id="products">
    <div class="wrap">

        <div class="sec-head">
            <span class="eyebrow">محصولات ما</span>
            <h2>سخت‌افزارها و نرم‌افزارهای حرفه‌ای</h2>
            <p>مجموعه‌ای کامل از تجهیزات ردیابی و سامانه‌های نرم‌افزاری برای مدیریت هوشمند ناوگان</p>
        </div>

        <div class="tabs">
            <button class="tab active" onclick="loadProducts(0, this)">همه محصولات</button>
            @if (Model.Categories.Any())
            {
                @foreach (var cat in Model.Categories)
                {
                    <button class="tab" onclick="loadProducts(@cat.Id, this)">@cat.Name</button>
                }
            }
        </div>

        <!-- اسلایدر -->
        <div style="position:relative;padding:0 28px;">
            <div id="productSliderWrap" style="overflow:hidden;">
                <div id="landingProductGrid"
                     style="display:flex;gap:20px;transition:transform .4s ease;
                    will-change:transform;">
                    <div style="min-width:100%;text-align:center;padding:40px;color:var(--gray);">
                        در حال بارگذاری...
                    </div>
                </div>
            </div>

            <!-- دکمه راست -->
            <button id="sliderPrev" onclick="slideProducts(-1)"
                    style="position:absolute;top:50%;right:0;
                transform:translateY(-50%);
                width:44px;height:44px;border-radius:50%;
                background:#fff;border:1px solid var(--line);
                display:flex;align-items:center;justify-content:center;
                cursor:pointer;z-index:10;
                box-shadow:0 4px 12px rgba(0,0,0,.1);
                font-size:18px;color:var(--navy);">
                <
                </button>

                <!-- دکمه چپ -->
                <button id="sliderNext" onclick="slideProducts(1)"
                        style="position:absolute;top:50%;left:0;
                    transform:translateY(-50%);
                    width:44px;height:44px;border-radius:50%;
                    background:#fff;border:1px solid var(--line);
                    display:flex;align-items:center;justify-content:center;
                    cursor:pointer;z-index:10;
                    box-shadow:0 4px 12px rgba(0,0,0,.1);
                    font-size:18px;color:var(--navy);">
                    >
                </button>
            </div>

            @* <!-- دکمه راست -->
            <button id="sliderPrev" onclick="slideProducts(-1)"
                    style="position:absolute;top:50%;right:-20px;
                transform:translateY(-50%);
                width:44px;height:44px;border-radius:50%;
                background:#fff;border:1px solid var(--line);
                display:flex;align-items:center;justify-content:center;
                cursor:pointer;z-index:10;
                box-shadow:0 4px 12px rgba(0,0,0,.1);
                transition:.2s;font-size:18px;color:var(--navy);">
                ›
            </button>

            <!-- دکمه چپ -->
            <button id="sliderNext" onclick="slideProducts(1)"
                    style="position:absolute;top:50%;left:-20px;
                transform:translateY(-50%);
                width:44px;height:44px;border-radius:50%;
                background:#fff;border:1px solid var(--line);
                display:flex;align-items:center;justify-content:center;
                cursor:pointer;z-index:10;
                box-shadow:0 4px 12px rgba(0,0,0,.1);
                transition:.2s;font-size:18px;color:var(--navy);">
                ‹
            </button> *@
        </div>

        <!-- dots -->
        <div id="sliderDots"
             style="display:flex;justify-content:center;gap:8px;margin-top:24px;">
        </div>

        <div class="products-cta" style="margin-top:32px;">
            <a href="/Product" class="pill pill-solid">مشاهده همه محصولات</a>
        </div>

        @* </div> *@
    </section>

    <section class="why" id="why">
        <div class="wrap">
            <div class="sec-head">
                <span class="eyebrow">چرا آرکا؟</span>
                <h2>مزایایی که ما را متمایز می‌کند</h2>
            </div>
            <div class="why-grid">
                <div class="why-card">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg></span>
                    <h3>گزارش‌گیری پیشرفته</h3>
                    <p>گزارش‌های متنوع و قابل خروجی‌سازی برای تصمیم‌گیری بهتر</p>
                </div>
                <div class="why-card">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M9 3a4 4 0 0 0-4 4 3 3 0 0 0-1 5.7A4 4 0 0 0 8 18a3 3 0 0 0 1-.2V21M15 3a4 4 0 0 1 4 4 3 3 0 0 1 1 5.7A4 4 0 0 1 16 18a3 3 0 0 1-1-.2V21M9 3v18M15 3v18" /></svg></span>
                    <h3>مدیریت هوشمند</h3>
                    <p>مدیریت رانندگان، مصرف سوخت و مسیرها به‌صورت یکپارچه</p>
                </div>
                <div class="why-card">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg></span>
                    <h3>هشدارهای لحظه‌ای</h3>
                    <p>اطلاع‌رسانی هوشمند برای رویدادهای مهم ناوگان</p>
                </div>
                <div class="why-card">
                    <span class="ic"><svg class="icon" viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1v-7h3Z" /><path d="M3 19a2 2 0 0 0 2 2h1v-7H3Z" /></svg></span>
                    <h3>پشتیبانی قوی</h3>
                    <p>تیم پشتیبانی متخصص برای پاسخگویی سریع و مؤثر</p>
                </div>
            </div>
        </div>
    </section>

    <section class="trusted">
        <div class="wrap">
            <div class="sec-head">
                <span class="eyebrow" style="color:var(--navy);">
                    برخی از سازمان‌های اعتمادکننده به ما
                </span>
            </div>

            <div style="display:flex;align-items:center;gap:16px;">
                <button onclick="scrollLogos(-1)"
                        style="width:36px;height:36px;border-radius:50%;border:1px solid var(--line);
                    background:#fff;cursor:pointer;flex-shrink:0;font-size:16px;
                    display:flex;align-items:center;justify-content:center;
                    color:var(--gray);transition:.2s;"
                        onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                        onmouseout="this.style.borderColor='var(--line)';this.style.color='var(--gray)'">
                    ‹
                </button>

                <div style="overflow:hidden;flex:1;">
                    <div id="logoTrack"
                         style="display:flex;align-items:center;justify-content:center;
                        gap:32px;transition:transform .4s ease;">
                        @foreach (var customer in Model.Customers)
                        {
                            <div style="flex-shrink:0;display:flex;flex-direction:column;
                                align-items:center;justify-content:center;gap:8px;">
                                @if (!string.IsNullOrEmpty(customer.LogoPath))
                                {
                                    <img src="@customer.LogoPath" alt="@customer.Name"
                                         style="height:56px;max-width:120px;object-fit:contain;
                                    transition:.2s;opacity:1;">
                                }
                                else
                                {
                                    <div style="height:56px;padding:0 16px;display:flex;
                                        align-items:center;justify-content:center;
                                        background:var(--paper);border:1px solid var(--line);
                                        border-radius:10px;">
                                        <span style="font-weight:700;font-size:15px;color:var(--navy);">
                                            @customer.Name
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <button onclick="scrollLogos(1)"
                        style="width:36px;height:36px;border-radius:50%;border:1px solid var(--line);
                    background:#fff;cursor:pointer;flex-shrink:0;font-size:16px;
                    display:flex;align-items:center;justify-content:center;
                    color:var(--gray);transition:.2s;"
                        onmouseover="this.style.borderColor='var(--blue)';this.style.color='var(--blue)'"
                        onmouseout="this.style.borderColor='var(--line)';this.style.color='var(--gray)'">
                    ›
                </button>
            </div>
        </div>
    </section>
    <section class="cta">
        <svg class="cta-skyline" viewBox="0 0 1180 220" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
            <g fill="#0a2e6b">
                <rect x="0" y="120" width="40" height="100" /><rect x="46" y="90" width="30" height="130" />
                <rect x="82" y="140" width="34" height="80" /><rect x="122" y="70" width="26" height="150" />
                <rect x="700" y="110" width="36" height="110" /><rect x="742" y="80" width="28" height="140" />
                <rect x="778" y="130" width="32" height="90" /><rect x="1000" y="95" width="30" height="125" />
                <rect x="1036" y="140" width="34" height="80" /><rect x="1076" y="60" width="24" height="160" />
