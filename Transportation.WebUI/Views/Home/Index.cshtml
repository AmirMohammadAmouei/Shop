    @section Scripts {
        <script>
            let sliderOffset = 0;
            let totalSlides = 0;
            const CARD_WIDTH = 300;
            const CARD_GAP = 20;

            function getVisibleCount() {
                const wrap = document.getElementById('productSliderWrap');
                return Math.floor(wrap.offsetWidth / (CARD_WIDTH + CARD_GAP));
            }

            function slideProducts(dir) {
                const track = document.getElementById('landingProductGrid');
                const wrap = document.getElementById('productSliderWrap');
                const visibleCount = getVisibleCount();
                const maxOffset = Math.max(0, (totalSlides - visibleCount) * (CARD_WIDTH + CARD_GAP));

                sliderOffset = Math.max(0, Math.min(sliderOffset + dir * (CARD_WIDTH + CARD_GAP), maxOffset));
                track.style.transform = `translateX(${sliderOffset}px)`;
                updateDots();
            }

            function goToPage(page) {
                const track = document.getElementById('landingProductGrid');
                const visibleCount = getVisibleCount();
                const wrap = document.getElementById('productSliderWrap');
                const maxOffset = Math.max(0, (totalSlides - visibleCount) * (CARD_WIDTH + CARD_GAP));

                sliderOffset = Math.min(page * visibleCount * (CARD_WIDTH + CARD_GAP), maxOffset);
                track.style.transform = `translateX(${sliderOffset}px)`;
                updateDots();
            }

            function updateDots() {
                const visibleCount = getVisibleCount();
                const pages = Math.ceil(totalSlides / visibleCount);
                const currentPage = Math.floor(sliderOffset / (visibleCount * (CARD_WIDTH + CARD_GAP)));
                const dots = document.getElementById('sliderDots');

                if (pages <= 1) { dots.innerHTML = ''; return; }

                dots.innerHTML = Array.from({ length: pages }, (_, i) => `
                                <div onclick="goToPage(${i})"
                                     style="width:${i === currentPage ? '24' : '8'}px;height:8px;
                                            border-radius:100px;cursor:pointer;transition:.3s;
                                            background:${i === currentPage ? 'var(--blue)' : 'var(--line)'};">
                                </div>`).join('');
            }

            async function loadProducts(catId, el) {
                document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
                el.classList.add('active');
                sliderOffset = 0;

                const track = document.getElementById('landingProductGrid');
                track.style.transform = 'translateX(0)';
                track.innerHTML = `
                                <div style="min-width:100%;text-align:center;padding:40px;color:var(--gray);">
                                    در حال بارگذاری...
                                </div>`;

                try {
                    const res = await fetch(`/Home/GetProductsByCategory?categoryId=${catId}`);
                    const data = await res.json();

                    if (!data.isSucceded || !data.items.length) {
                        track.innerHTML = `
                                        <div style="min-width:100%;text-align:center;padding:40px;color:var(--gray);">
                                            محصولی یافت نشد
                                        </div>`;
                        document.getElementById('sliderDots').innerHTML = '';
                        return;
                    }

                    totalSlides = data.items.length;

                    // اگه یه محصول بود وسط‌چین بشه
                    const justify = totalSlides === 1 ? 'center' : 'flex-start';
                    track.style.justifyContent = justify;

                    track.innerHTML = data.items.map(p => `
                                    <div class="p-card"
                                         style="min-width:${CARD_WIDTH}px;max-width:${CARD_WIDTH}px;
                                                display:flex;flex-direction:column;
                                                overflow:hidden;flex-shrink:0;">
                                        <div style="width:100%;height:200px;overflow:hidden;flex-shrink:0;">
                                            ${p.images && p.images.length
                            ? `<img src="${p.images[0].path}" alt="${p.name}"
                                                       style="width:100%;height:100%;object-fit:cover;">`
                            : `<div style="width:100%;height:200px;background:#e3e9f7;
                                                               display:flex;align-items:center;justify-content:center;">
                                                       <svg viewBox="0 0 100 100" style="width:60px;height:60px;">
                                                           <rect x="20" y="20" width="60" height="60" rx="8" fill="#e3e9f7"/>
                                                           <path d="M35 50h30M50 35v30" stroke="#3f8bff"
                                                                 stroke-width="3" stroke-linecap="round"/>
                                                       </svg>
                                                   </div>`
                        }
                                        </div>
                                        <div style="padding:16px;display:flex;flex-direction:column;
                                                    gap:12px;flex:1;min-height:110px;">
                                            <h3 style="font-size:14px;font-weight:700;color:var(--navy);
                                                       overflow:hidden;display:-webkit-box;
                                                       -webkit-line-clamp:2;-webkit-box-orient:vertical;
                                                       margin:0;line-height:1.6;height:44px;">
                                                ${p.name ?? ''}
                                            </h3>
                                            <a href="/Product/GetDetails/${p.id}" class="pill pill-solid"
                                               style="width:100%;justify-content:center;
                                                      margin-top:auto;background:var(--blue);">
                                                مشاهده محصول
                                            </a>
                                        </div>
                                    </div>`).join('');

                    updateDots();

                    // دکمه‌ها رو مخفی کن اگه همه کارت‌ها جا میشن
                    const visibleCount = getVisibleCount();
                    const showBtns = totalSlides > visibleCount;
                    document.getElementById('sliderPrev').style.display = showBtns ? 'flex' : 'none';
                    document.getElementById('sliderNext').style.display = showBtns ? 'flex' : 'none';

                } catch (err) {
                    track.innerHTML = `
                                    <div style="text-align:center;padding:40px;color:#b91c1c;">
                                        خطا در بارگذاری
                                    </div>`;
                }
            }

            window.addEventListener('DOMContentLoaded', () => {
                loadProducts(0, document.querySelector('.tabs .tab'));
            });

            let logoOffset = 0;
            const logoStep = 160;

            function scrollLogos(dir) {
                const track = document.getElementById('logoTrack');
                const maxOffset = track.scrollWidth - track.parentElement.offsetWidth;
                logoOffset = Math.max(0, Math.min(logoOffset + dir * logoStep, maxOffset));
                track.style.transform = `translateX(${logoOffset}px)`;
            }


            // اسلایدر about
            let aboutIndex = 0;
            const aboutSlides = document.querySelectorAll('.about-slide');
            const aboutDots = document.querySelectorAll('.about-dot');
            let aboutTimer;

            function goToAboutSlide(idx) {
                aboutSlides.forEach((s, i) => {
                    s.style.opacity = i === idx ? '1' : '0';
                    s.style.pointerEvents = i === idx ? 'auto' : 'none';
                });
                aboutDots.forEach((d, i) => {
                    d.style.width = i === idx ? '22px' : '8px';
                    d.style.background = i === idx ? 'var(--blue)' : 'rgba(255,255,255,.5)';
                });
                aboutIndex = idx;
            }

            function aboutSlide(dir) {
                clearInterval(aboutTimer);
                const next = (aboutIndex + dir + aboutSlides.length) % aboutSlides.length;
                goToAboutSlide(next);
                startAboutTimer();
            }

            function startAboutTimer() {
                if (aboutSlides.length <= 1) return;
                aboutTimer = setInterval(() => {
                    const next = (aboutIndex + 1) % aboutSlides.length;
                    goToAboutSlide(next);
                }, 4000);
            }

            document.addEventListener('DOMContentLoaded', () => {
                if (aboutSlides.length > 1) startAboutTimer();
            });
        </script>
    }