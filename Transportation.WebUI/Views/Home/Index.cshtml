@section Scripts {
    <script>
        async function loadProducts(catId, el) {
            document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');

            document.getElementById('landingProductGrid').innerHTML = `
                <div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--gray);">
                    در حال بارگذاری...
                </div>`;

            try {
                const res = await fetch(`/Home/GetProductsByCategory?categoryId=${catId}`);
                const data = await res.json();

                if (!data.isSucceded || !data.items.length) {
                    document.getElementById('landingProductGrid').innerHTML = `
                        <div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--gray);">
                            محصولی یافت نشد
                        </div>`;
                    return;
                }

                document.getElementById('landingProductGrid').innerHTML = data.items.map(p => `
                    <div class="p-card">
                        <div class="thumb">
                            ${p.images && p.images.length
                        ? `<img src="${p.images[0].path}" alt="${p.name}"
                                       style="width:72px; height:72px; object-fit:contain;">`
                        : `<svg viewBox="0 0 100 100">
                                       <rect x="20" y="20" width="60" height="60" rx="8" fill="#e3e9f7"/>
                                       <path d="M35 50h30M50 35v30" stroke="#3f8bff"
                                             stroke-width="3" stroke-linecap="round"/>
                                   </svg>`
                    }
                        </div>
                        <div class="body" style="text-align:center;">
                            <h3>${p.name ?? ''}</h3>
                            <p>${p.description ?? ''}</p>
                            <a href="/Product/Detail/${p.id}" class="pill pill-ghost-dark" style="width:100%;">
                                مشاهده محصول
                            </a>
                        </div>
                    </div>
                `).join('');

            } catch (err) {
                document.getElementById('landingProductGrid').innerHTML = `
                    <div style="grid-column:1/-1; text-align:center; padding:40px; color:#b91c1c;">
                        خطا در بارگذاری
                    </div>`;
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadProducts(0, document.querySelector('.tabs .tab'));
        });
    </script>
}