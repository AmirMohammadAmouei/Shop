@section Scripts {
    <script>
        let currentCatId = 0;
        let currentPage = 1;
        const pageSize = 9;
        let searchTimer = null;

        function filterCategory(catId, el) {
            event.preventDefault();
            currentCatId = catId;
            currentPage = 1;
            document.querySelectorAll('.cat-list a').forEach(a => a.classList.remove('active'));
            el.classList.add('active');
            loadProducts();
        }

        function onSearch(val) {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => { currentPage = 1; loadProducts(); }, 400);
        }

        function goToPage(page) {
            currentPage = page;
            loadProducts();
            window.scrollTo({
                top: document.getElementById('productGrid').offsetTop - 120,
                behavior: 'smooth'
            });
        }

        async function loadProducts() {
            document.getElementById('productGrid').innerHTML = `
                            <div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--gray);">
                                <i class="bi bi-arrow-repeat"></i> در حال بارگذاری...
                            </div>`;
            document.getElementById('pagination').innerHTML = '';
            document.getElementById('resultCount').innerHTML = '...';

            const search = document.getElementById('searchInput').value ?? '';
            const url = `/Product/GetProductsByCategoryId?categoryId=${currentCatId}`
                + `&PageNumber=${currentPage}&PageSize=${pageSize}`
                + `&SearchTerm=${encodeURIComponent(search)}`;

            try {
                const res = await fetch(url);
                const data = await res.json();

                if (!data.isSucceded || !data.items || data.items.length === 0) {
                    document.getElementById('productGrid').innerHTML = `
                                    <div style="grid-column:1/-1; text-align:center; padding:60px; color:var(--gray);">
                                        <i class="bi bi-box-seam" style="font-size:2.4rem; opacity:.4;
                                           display:block; margin:0 auto 12px;"></i>
                                        <p>محصولی یافت نشد</p>
                                    </div>`;
                    document.getElementById('resultCount').innerHTML = 'محصولی یافت نشد';
                    return;
                }

                const from = (currentPage - 1) * pageSize + 1;
                const to = Math.min(currentPage * pageSize, data.totalCount);
                document.getElementById('resultCount').innerHTML =
                    `نمایش <b>${toFa(from)} تا ${toFa(to)}</b> از <b>${toFa(data.totalCount)}</b> محصول`;

                document.getElementById('productGrid').innerHTML = data.items.map(p => `
                                <div class="p-card">
                                    <div class="thumb">
                                        ${p.images && p.images.length
                        ? `<img src="${p.images[0].path}" alt="${p.name}"
                                                   style="width:88px;height:88px;object-fit:contain;">`
                        : `<svg viewBox="0 0 100 100">
                                                   <rect x="20" y="20" width="60" height="60" rx="8" fill="#e3e9f7"/>
                                                   <path d="M35 50h30M50 35v30" stroke="#3f8bff"
                                                         stroke-width="3" stroke-linecap="round"/>
                                               </svg>`
                    }
                                    </div>
                                    <div class="body">
                                        <span class="cat-lbl">${p.categoryName ?? ''}</span>
                                        <h3>${p.name ?? ''}</h3>
                                        <p>${p.description ?? ''}</p>
                                                 <div class="foot-row">
                    <button onclick="downloadApp(${p.id})"
                            class="pill pill-solid pill-sm" style="width:100%;justify-content:center;border:none;cursor:pointer;">
                        <i class="bi bi-download"></i>
                        دانلود
                    </button>
                </div>
                                    </div>
                                </div>
                            `).join('');

                renderPagination(data.totalPages, data.currentPage);

            } catch (err) {
                document.getElementById('productGrid').innerHTML = `
                                <div style="grid-column:1/-1; text-align:center; padding:40px; color:#b91c1c;">
                                    خطا در بارگذاری محصولات
                                </div>`;
            }
        }

        async function downloadApp(id) {
            debugger;
            try {
                const res = await fetch(`/MobileApp/Download?id=${id}`);

                if (!res.ok) {
                    toastr.error('خطا در دانلود فایل');
                    return;
                }

                const blob = await res.blob();

                // نام فایل از header
                const disposition = res.headers.get('Content-Disposition');
                let fileName = 'rahnegar-app';
                if (disposition) {
                    const match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (match) fileName = match[1].replace(/['"]/g, '');
                }

                // دانلود بدون تغییر صفحه
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);

                toastr.success('دانلود شروع شد');

            } catch {
                toastr.error('خطا در ارتباط با سرور');
            }
        }

        function renderPagination(totalPages, page) {
            const pg = document.getElementById('pagination');
            if (totalPages <= 1) { pg.innerHTML = ''; return; }

            let html = `<a href="#"
                            onclick="event.preventDefault();${page > 1 ? `goToPage(${page - 1})` : ''}"
                            ${page === 1 ? 'style="opacity:.4;pointer-events:none;"' : ''}>‹</a>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === page) {
                    html += `<a href="#" class="active"
                                            onclick="event.preventDefault();">${toFa(i)}</a>`;
                } else if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) {
                    html += `<a href="#"
                                            onclick="event.preventDefault();goToPage(${i})">${toFa(i)}</a>`;
                } else if (Math.abs(i - page) === 2) {
                    html += `<span class="dots">…</span>`;
                }
            }

            html += `<a href="#"
                            onclick="event.preventDefault();${page < totalPages ? `goToPage(${page + 1})` : ''}"
                            ${page === totalPages ? 'style="opacity:.4;pointer-events:none;"' : ''}>›</a>`;

            pg.innerHTML = html;
        }

        function toFa(n) {
            return n.toString().replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
        }

        window.addEventListener('DOMContentLoaded', () => {
            filterCategory(0, document.querySelector('.cat-list a'));
        });
    </script>
}
