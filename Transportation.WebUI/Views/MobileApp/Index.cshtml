@using Transportation.Buisness.Services.MobileApps.Dtos
@using Transportation.Buisness._0.Common.Paging
@model SPFOutPutDto<MobileAppListResponseDto>

@{
    ViewData["Title"] = "محصولات | راهنگار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .contact-price {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(90deg, var(--blue), var(--blue-light));
        color: #fff;
        font-size: 12.5px;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: 100px;
        text-decoration: none;
        transition: .2s;
    }

        .contact-price:hover {
            filter: brightness(1.1);
            color: #fff;
        }

    .app-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        flex: 1;
        min-width: 260px;
        max-width: 380px;
        transition: .2s;
    }

        .app-card:hover {
            box-shadow: 0 8px 24px rgba(10,20,60,.09);
            border-color: var(--blue-light);
        }

    .app-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: #fff;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

    .app-download {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(90deg, var(--blue), var(--blue-light));
        color: #fff;
        font-size: 12.5px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 100px;
        text-decoration: none;
        transition: .2s;
        margin-top: 10px;
    }

        .app-download:hover {
            filter: brightness(1.08);
            color: #fff;
            transform: translateY(-1px);
        }
</style>

<section class="banner">
    <div class="wrap">
        <div class="crumb">
            <a asp-controller="Home" asp-action="Index">خانه</a> / <span>برنامه ها</span>
        </div>
        <h1>محصولات راهنگار</h1>
        <p>مجموعه‌ای کامل از سخت‌افزارها و نرم‌افزارهای ردیابی و مدیریت هوشمند ناوگان</p>
    </div>
</section>
