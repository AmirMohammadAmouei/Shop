<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>راهنگار | سامانه کنترل هوشمند ناوگان</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="~/css/index.css">
    <link rel="stylesheet" href="~/css/toastr.min.css">
    <link rel="stylesheet" href="~/css/product.css" > 
    <style>
            :root {
                --navy: #01112a;
                --navy-2: #0a1e46;
                --blue: #1e62c7;
                --blue-light: #3f8bff;
                --blue-glow: #5aa2ff;
                --ink: #1c2540;
                --gray: #7c869e;
                --gray-light: #a9b3d2;
                --paper: #f1f5fe;
                --line: #e3e9f7;
                --white: #ffffff;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: 'Vazirmatn', sans-serif;
                color: var(--ink);
                background: var(--white);
                line-height: 1.9;
                font-size: 15px;
            }

            img, svg {
                max-width: 100%;
                display: block;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            ul {
                list-style: none;
            }

            button {
                font-family: inherit;
                cursor: pointer;
            }

            .wrap {
                max-width: 1180px;
                margin: 0 auto;
                padding: 0 28px;
            }

            .pill {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 13px 30px;
                border-radius: 100px;
                font-weight: 600;
                font-size: 14.5px;
                border: 1.5px solid transparent;
                transition: .2s ease;
                white-space: nowrap;
            }

            .pill-solid {
                background: var(--blue);
                color: #fff;
            }

                .pill-solid:hover {
                    background: #1c58b3;
                    transform: translateY(-1px);
                }

            .pill-ghost-light {
                background: transparent;
                color: #fff;
                border-color: rgba(255,255,255,.4);
            }

                .pill-ghost-light:hover {
                    background: rgba(255,255,255,.08);
                    border-color: rgba(255,255,255,.7);
                }

            .pill-ghost-dark {
                background: #fff;
                color: var(--ink);
                border-color: var(--line);
            }

                .pill-ghost-dark:hover {
                    border-color: var(--blue);
                    color: var(--blue);
                }

            .pill-sm {
                padding: 9px 18px;
                font-size: 13px;
            }

            .eyebrow {
                color: var(--blue);
                font-weight: 700;
                font-size: 13.5px;
                letter-spacing: .2px;
                display: block;
                margin-bottom: 12px;
            }

            section {
                padding: 96px 0;
            }

            h1, h2, h3 {
                color: var(--navy);
                font-weight: 800;
            }

            .icon {
                stroke: currentColor;
                fill: none;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            /* ============ HEADER ============ */
            header {
                position: sticky;
                top: 0;
                z-index: 60;
                background: var(--navy);
                border-bottom: 1px solid rgba(255,255,255,.06);
            }

            .nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 0;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .logo .pin-badge {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background: var(--blue);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                    .logo .pin-badge svg {
                        width: 18px;
                        height: 18px;
                        stroke: #fff;
                        fill: #fff;
                    }

                .logo .name {
                    color: #fff;
                    font-weight: 800;
                    font-size: 18px;
                    line-height: 1.3;
                }

                .logo .tag {
                    color: var(--gray-light);
                    font-size: 10.5px;
                    font-weight: 400;
                }

            .nav-links {
                display: flex;
                align-items: center;
                gap: 32px;
            }

                .nav-links a {
                    color: #c3cce8;
                    font-size: 14px;
                    font-weight: 500;
                    position: relative;
                    padding-bottom: 4px;
                    transition: .2s;
                }

                    .nav-links a:hover {
                        color: #fff;
                    }

                    .nav-links a.active {
                        color: #fff;
                    }

                        .nav-links a.active::after {
                            content: "";
                            position: absolute;
                            right: 0;
                            bottom: -14px;
                            width: 100%;
                            height: 2px;
                            background: var(--blue-light);
                        }

            /* ============ HERO ============ */
            .hero {
                position: relative;
                overflow: hidden;
                padding: 0;
                background: radial-gradient(circle at 82% 62%, #123a7a 0%, #081a3f 45%, #01112a 78%);
                min-height: 720px;
                display: flex;
                align-items: stretch;
            }

            .hero-scene {
                position: absolute;
                right: 0;
                bottom: 0;
                width: 44%;
                height: 46%;
                z-index: 0;
            }

                .hero-scene svg {
                    width: 100%;
                    height: 100%;
                    overflow: visible;
                }

            .hero-pin {
                position: absolute;
                top: 36%;
                right: 2%;
                width: 120px;
                z-index: 0;
            }

                .hero-pin svg {
                    width: 100%;
                    height: auto;
                    overflow: visible;
                }

            .hero-fade {
                position: absolute;
                inset: 0;
                z-index: 1;
                pointer-events: none;
                background: linear-gradient(90deg, var(--navy) 0%, rgba(1,17,42,.97) 26%, rgba(1,17,42,.8) 42%, rgba(1,17,42,.4) 58%, rgba(1,17,42,.08) 75%, transparent 88%);
            }

            .hero .wrap {
                position: relative;
                z-index: 2;
                padding-top: 78px;
                padding-bottom: 56px;
                width: 100%;
            }

            .hero-inner {
                max-width: 460px;
            }

            .hero h1 {
                font-size: 34px;
                line-height: 1.5;
                color: #fff;
                margin-bottom: 18px;
            }

                .hero h1 .line2 {
                    color: var(--blue-light);
                    display: block;
                }

            .hero p {
                color: #a9b3d2;
                font-size: 14.5px;
                max-width: 420px;
                margin-bottom: 28px;
            }

            .hero-actions {
                display: flex;
                gap: 14px;
                margin-bottom: 58px;
                flex-wrap: wrap;
            }

            .hero-feats {
                display: grid;
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: 18px 22px;
                max-width: 410px;
            }

            .hero-feat {
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .hero-feat .ic {
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    border: 1px solid rgba(63,139,255,.4);
                    background: rgba(63,139,255,.08);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                    .hero-feat .ic svg {
                        width: 17px;
                        height: 17px;
                        stroke: var(--blue-light);
                    }

                .hero-feat b {
                    display: block;
                    color: #fff;
                    font-size: 13px;
                    font-weight: 600;
                }

                .hero-feat span {
                    color: #8b96b8;
                    font-size: 11.5px;
                }

            /* ============ ABOUT ============ */
            .about .wrap {
                display: grid;
                grid-template-columns: .95fr 1.05fr;
                gap: 64px;
                align-items: center;
            }

            .about-media {
                position: relative;
                height: 440px;
            }

            .m-earth {
                position: absolute;
                top: 0;
                right: 0;
                width: 52%;
                aspect-ratio: 1.05/1;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 20px 45px rgba(10,20,60,.22);
                border: 5px solid #fff;
            }

            .m-highway {
                position: absolute;
                top: 14%;
                right: 38%;
                width: 56%;
                aspect-ratio: 1.35/1;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 20px 45px rgba(10,20,60,.22);
                border: 5px solid #fff;
            }

            .m-dash {
                position: absolute;
                bottom: 0;
                right: 6%;
                width: 78%;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 25px 55px rgba(10,20,60,.28);
                background: #0e1a3a;
                border: 5px solid #fff;
            }

                .m-dash svg {
                    display: block;
                    width: 100%;
                    height: auto;
                }

            .about h2 {
                font-size: 29px;
                line-height: 1.55;
                margin-bottom: 18px;
            }

            .about > .wrap > div:last-child > p {
                color: var(--gray);
                font-size: 14.5px;
                margin-bottom: 36px;
                max-width: 480px;
            }

            .about-stats {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 16px;
                margin-bottom: 34px;
            }

                .about-stats .stat .ic {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: rgba(30,98,199,.1);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 12px;
                }

                    .about-stats .stat .ic svg {
                        width: 16px;
                        height: 16px;
                        stroke: var(--blue);
                    }

                .about-stats .num {
                    font-size: 23px;
                    font-weight: 800;
                    color: var(--navy);
                }

                .about-stats .lbl {
                    font-size: 12.5px;
                    color: var(--gray);
                    margin-top: 3px;
                }

            /* ============ PRODUCTS ============ */
            .products {
                background: var(--paper);
            }

            .sec-head {
                text-align: center;
                max-width: 600px;
                margin: 0 auto 44px;
            }

                .sec-head .eyebrow {
                    text-align: center;
                }

                .sec-head h2 {
                    font-size: 28px;
                    margin-bottom: 12px;
                    line-height: 1.5;
                }

                .sec-head p {
                    color: var(--gray);
                    font-size: 14.5px;
                }

            .tabs {
                display: flex;
                justify-content: center;
                gap: 10px;
                margin-bottom: 44px;
                flex-wrap: wrap;
            }

            .tab {
                padding: 10px 22px;
                border-radius: 100px;
                font-size: 13.5px;
                font-weight: 600;
                background: #fff;
                color: var(--gray);
                border: 1px solid var(--line);
            }

                .tab.active {
                    background: var(--blue);
                    color: #fff;
                    border-color: var(--blue);
                }

            .product-grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 20px;
                margin-bottom: 40px;
            }

            /* قبل */
            .p-card {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 16px;
                padding: 30px 22px 24px; /* ← این رو حذف کن */
                text-align: center;
                transition: .25s;
            }

                .p-card .thumb {
                    height: 96px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 20px; /* ← این رو حذف کن */
                }

                .p-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 20px 36px rgba(10,20,60,.09);
                    border-color: transparent;
                }

                /* .p-card .thumb {
                    height: 96px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 20px;
                } */

                    .p-card .thumb svg {
                        width: 72px;
                        height: 72px;
                    }

                .p-card h3 {
                    font-size: 15.5px;
                    margin-bottom: 9px;
                }

                .p-card p {
                    color: var(--gray);
                    font-size: 12.8px;
                    margin-bottom: 20px;
                    min-height: 38px;
                }

                .p-card .pill {
                    width: 100%;
                }

            .products-cta {
                text-align: center;
            }

            /* ============ WHY US ============ */
            .why {
                background: var(--navy);
                color: #fff;
            }

                .why .sec-head h2 {
                    color: #fff;
                }

                .why .sec-head p {
                    color: var(--gray-light);
                }

            .why-grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 36px;
                text-align: center;
            }

            .why-card .ic {
                width: 56px;
                height: 56px;
                margin: 0 auto 20px;
                border-radius: 14px;
                background: rgba(63,139,255,.1);
                border: 1px solid rgba(63,139,255,.25);
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .why-card .ic svg {
                    width: 26px;
                    height: 26px;
                    stroke: var(--blue-light);
                }

            .why-card h3 {
                color: #fff;
                font-size: 15px;
                margin-bottom: 10px;
            }

            .why-card p {
                color: #8b96b8;
                font-size: 12.8px;
            }

            /* ============ TRUSTED ============ */
            .trusted {
                padding: 60px 0;
            }

                .trusted .sec-head {
                    margin-bottom: 34px;
                }

            .logo-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
            }

                .logo-row .arrow {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    border: 1px solid var(--line);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: var(--gray);
                    flex-shrink: 0;
                }

            .logo-track {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 28px;
                flex: 1;
                flex-wrap: wrap;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #9aa5c4;
                font-weight: 700;
                font-size: 15px;
            }

                .brand-logo svg {
                    width: 26px;
                    height: 26px;
                    stroke: #9aa5c4;
                }

            /* ============ CTA ============ */
            .cta {
                position: relative;
                overflow: hidden;
                background: linear-gradient(120deg,#0a2e6b 0%, #0d1a3d 60%, #08132e 100%);
                color: #fff;
            }

            .cta-skyline {
                position: absolute;
                inset: 0;
                opacity: .18;
            }

            .cta .wrap {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 40px;
                flex-wrap: wrap;
            }

            .cta-main h2 {
                color: #fff;
                font-size: 25px;
                margin-bottom: 10px;
                line-height: 1.5;
            }

            .cta-main p {
                color: #b7c2e2;
                font-size: 14px;
                margin-bottom: 22px;
                max-width: 420px;
            }

            .cta-main .pill {
                background: #fff;
                color: var(--blue);
            }

                .cta-main .pill:hover {
                    background: #eaf1ff;
                }

            .cta-side {
                display: flex;
                align-items: center;
                gap: 16px;
            }

                .cta-side .ic {
                    width: 52px;
                    height: 52px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.08);
                    border: 1px solid rgba(255,255,255,.15);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                }

                    .cta-side .ic svg {
                        width: 24px;
                        height: 24px;
                        stroke: #fff;
                    }

                .cta-side p {
                    color: #c3cce8;
                    font-size: 13px;
                    margin-bottom: 12px;
                    max-width: 190px;
                }

            /* ============ FOOTER ============ */
            footer {
                background: var(--navy);
                color: var(--gray-light);
                padding: 64px 0 26px;
                font-size: 13.5px;
            }

            .foot-grid {
                display: grid;
                grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
                gap: 36px;
                padding-bottom: 40px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

                .foot-grid h4 {
                    color: #fff;
                    font-size: 14.5px;
                    margin-bottom: 18px;
                    font-weight: 700;
                }

                .foot-grid li {
                    margin-bottom: 11px;
                    color: #8b96b8;
                }

            .foot-brand {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-bottom: 14px;
            }

                .foot-brand .pin-badge {
                    width: 32px;
                    height: 32px;
                    border-radius: 50%;
                    background: var(--blue);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                    .foot-brand .pin-badge svg {
                        width: 16px;
                        height: 16px;
                        stroke: #fff;
                        fill: #fff;
                    }

                .foot-brand .name {
                    color: #fff;
                    font-weight: 800;
                    font-size: 16.5px;
                }

                .foot-brand .tag {
                    color: var(--gray-light);
                    font-size: 10px;
                }

            .foot-desc {
                color: #8b96b8;
                max-width: 270px;
                margin-bottom: 20px;
            }

            .foot-contact li {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .foot-contact svg {
                width: 15px;
                height: 15px;
                stroke: var(--blue-light);
                flex-shrink: 0;
            }

            .socials {
                display: flex;
                gap: 10px;
            }

                .socials a {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    background: rgba(255,255,255,.06);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: .2s;
                }

                    .socials a:hover {
                        background: var(--blue);
                    }

                .socials svg {
                    width: 15px;
                    height: 15px;
                    stroke: #fff;
                }

            .foot-bottom {
                text-align: center;
                padding-top: 22px;
                font-size: 12.5px;
                color: #6c7899;
            }

            @@media (max-width:980px) {
                .nav-links {
                    display: none;
                }

                .hero {
                    min-height: auto;
                }

                .hero-inner {
                    max-width: 100%;
                }

                .hero-scene {
                    opacity: .35;
                }

                .hero-fade {
                    background: linear-gradient(180deg, var(--navy) 60%, rgba(1,17,42,.85));
                }

                .about .wrap {
                    grid-template-columns: 1fr;
                }

                .about-media {
                    margin-bottom: 20px;
                    height: 360px;
                }

                .product-grid {
                    grid-template-columns: repeat(2,1fr);
                }

                .why-grid {
                    grid-template-columns: repeat(2,1fr);
                    gap: 30px;
                }

                .about-stats {
                    grid-template-columns: repeat(2,1fr);
                }

                .foot-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .cta .wrap {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .logo-track {
                    justify-content: center;
                }
            }

            @@media (max-width:560px) {
                .product-grid {
                    grid-template-columns: 1fr;
                }

                .why-grid {
                    grid-template-columns: 1fr;
                }

                .hero h1 {
                    font-size: 30px;
                }
            }
    </style>
</head>
<body>

    <header>
        <div class="wrap nav">
            <div class="logo">
                <span class="pin-badge">
                    <svg viewBox="0 0 24 24"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8Z" /><circle cx="12" cy="10" r="2.6" fill="#1e62c7" stroke="none" /></svg>
                </span>
                <a asp-controller="Home" asp-action="Index">
                    <span>
                        <span class="name" style="display:block;">راهنگار</span>
                        <span class="tag">سامانه کنترل هوشمند ناوگان</span>
                    </span>
                </a>
            </div>
            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">خانه</a>
                <a asp-controller="Product" asp-action="Index">محصولات</a>
                @* <a href="#why">راهکارها</a> *@
                <a asp-controller="Home" asp-action="AboutUs">درباره ما</a>
                <a asp-controller="MobileApp" asp-action="Index">برنامه ها</a> 
                <a href="#">تماس با ما</a>
            </nav>
            <div class="download-buttons">

                @if (User.Identity.IsAuthenticated)
                {

                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="pill pill-solid pill-sm">ورود به پنل</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="pill pill-solid pill-sm">ورود به سامانه</a>
                }
                @* <a href="#" class="pill pill-solid pill-sm">دانلود برنامه</a> *@
            </div>
        </div>
    </header>
    @RenderBody()
    <footer>
        <div class="wrap">
            <div class="foot-grid">
                <div>
                    <div class="foot-brand">
                        <span class="pin-badge"><svg viewBox="0 0 24 24"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8Z" /></svg></span>
                        <span><span class="name" style="display:block;">راهنگار</span><span class="tag">سامانه کنترل هوشمند ناوگان</span></span>
                    </div>
                    <p class="foot-desc">ارائه‌دهنده راهکارهای جامع ردیابی و مدیریت ناوگان با بهترین کیفیت و پشتیبانی در ایران.</p>
