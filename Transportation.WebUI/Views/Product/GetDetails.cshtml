@model Transportation.Buisness.Services.Products.Dto.ProductDetailsDto

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .wrap {
        overflow: visible !important;
    }
</style>
<section class="banner" style="padding:28px 0;">
    <div class="wrap">
        <div class="crumb">
            <a asp-controller="Home" asp-action="Index">خانه</a> /
            <a asp-controller="Product" asp-action="Index">محصولات</a> /
            <span>@Model.CategoryName</span>
        </div>
    </div>
</section>

<section style="padding:40px 0 64px;background:#fff;">
    <div class="wrap">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">

            <!-- ===== گالری ===== -->
            <div>
                <!-- Wrapper بیرونی — بدون overflow:hidden -->
                <div style="position:relative;height:440px;margin:0 20px;">

                    <!-- کارت عکس — با overflow:hidden -->
                    <div style="border-radius:16px;overflow:hidden;
                        border:1px solid var(--line);height:100%;">
                        <div id="galleryTrack"
                             style="display:flex;height:100%;
                            transition:transform .35s ease;
                            will-change:transform;">
                            @if (Model.ImagesPath.Any())
                            {
                                @foreach (var img in Model.ImagesPath)
                                {
                                    <div style="min-width:100%;height:100%;flex-shrink:0;">
                                        <img src="@img.Path"
                                             style="width:100%;height:100%;object-fit:cover;">
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="min-width:100%;height:100%;flex-shrink:0;
                                    display:flex;flex-direction:column;
                                    align-items:center;justify-content:center;
                                    color:var(--gray);background:var(--paper);">
                                    <i class="bi bi-image" style="font-size:3rem;opacity:.3;"></i>
                                    <span style="margin-top:12px;font-size:14px;">تصویری ثبت نشده</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (Model.ImagesPath.Count > 1)
                    {
                
                        <button onclick="prevSlide()"
                                style="position:absolute;top:50%;right:12px;
                            transform:translateY(-50%);
                            width:40px;height:40px;border-radius:50%;
                            background:rgba(255,255,255,.95);
                            border:none;font-size:20px;font-weight:700;
                            display:flex;align-items:center;justify-content:center;
                            cursor:pointer;z-index:20;
                            box-shadow:0 2px 10px rgba(0,0,0,.2);
                            color:var(--navy);line-height:1;">
                            ‹
                        </button>

                        <button onclick="nextSlide()"
                                style="position:absolute;top:50%;left:12px;
                            transform:translateY(-50%);
                            width:40px;height:40px;border-radius:50%;
                            background:rgba(255,255,255,.95);
                            border:none;font-size:20px;font-weight:700;
                            display:flex;align-items:center;justify-content:center;
                            cursor:pointer;z-index:20;
                            box-shadow:0 2px 10px rgba(0,0,0,.2);
                            color:var(--navy);line-height:1;">
                            ›
                        </button>

                        <!-- شماره -->
                        <div id="slideCounter"
                             style="position:absolute;bottom:12px;left:50%;
                            transform:translateX(-50%);
                            background:rgba(0,0,0,.45);color:#fff;
                            border-radius:100px;padding:4px 14px;
                            font-size:12px;z-index:10;">
                            ۱ / @Model.ImagesPath.Count
                        </div>
                    }
                </div>

                <!-- Thumbnails -->
                @if (Model.ImagesPath.Count > 1)
                {
                    <div style="display:flex;gap:10px;margin-top:12px;
                        flex-wrap:wrap;justify-content:center;">
                        @for (int i = 0; i < Model.ImagesPath.Count; i++)
                        {
                            <div onclick="goToSlide(@i)" id="thumb-@i"
                                 style="width:80px;height:80px;border-radius:10px;
                                overflow:hidden;cursor:pointer;flex-shrink:0;
                                border:2px solid @(i == 0 ? "var(--blue)" : "var(--line)");
                                transition:.2s;">
                                <img src="@Model.ImagesPath[i].Path"
                                     style="width:100%;height:100%;object-fit:cover;">
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- ===== اطلاعات ===== -->
            <div>
                <span class="eyebrow" style="margin-bottom:8px;display:block;">
                    @Model.CategoryName
                </span>

                <h1 style="font-size:22px;font-weight:800;color:var(--navy);
                    line-height:1.7;margin-bottom:20px;">
                    @Model.Name
                </h1>

                @if (Model.ShowPrice)
                {
                    <div style="display:inline-flex;align-items:baseline;gap:8px;
                        background:linear-gradient(90deg,#eaf1ff,#f5f8ff);
                        border:1px solid rgba(30,98,199,.15);border-radius:12px;
                        padding:12px 20px;margin-bottom:24px;">
                        <span style="font-size:24px;font-weight:800;color:var(--blue);">
                            @Model.Price.ToString("N0")
                        </span>
                        <span style="font-size:13px;color:var(--gray);font-weight:500;">تومان</span>
                    </div>
                }
                else
                {
                    <div style="display:inline-flex;align-items:center;gap:8px;
                        background:var(--paper);border:1px solid var(--line);
                        border-radius:12px;padding:12px 20px;margin-bottom:24px;">
                        <i class="bi bi-telephone-fill" style="color:var(--blue);"></i>
                        <span style="font-size:14px;font-weight:600;color:var(--navy);">
                            برای قیمت تماس بگیرید
                        </span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div style="color:var(--ink);font-size:14px;line-height:2;
                        margin-bottom:28px;padding:16px;background:var(--paper);
                        border-radius:12px;border:1px solid var(--line);">
                        @Html.Raw(Model.Description)
                    </div>
                }

                @* <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px;">
                    <a href="tel:09178237255" class="pill pill-solid"
                       style="flex:1;justify-content:center;">
                        <i class="bi bi-telephone-fill ms-2"></i>
                        تماس برای خرید
                    </a>
                    <a asp-controller="Product" asp-action="Index"
                       class="pill pill-ghost-dark" style="flex:1;justify-content:center;">
                        <i class="bi bi-arrow-right ms-2"></i>
                        بازگشت
                    </a>
                </div> *@

                @* <div style="padding:18px;background:var(--paper);
                    border-radius:14px;border:1px solid var(--line);">
                    <div style="display:flex;align-items:center;gap:10px;
                        padding-bottom:12px;border-bottom:1px solid var(--line);
                        margin-bottom:12px;">
                        <i class="bi bi-shield-check-fill" style="color:var(--blue);"></i>
                        <span style="font-size:13px;font-weight:600;color:var(--navy);">گارانتی اصالت کالا</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;
                        padding-bottom:12px;border-bottom:1px solid var(--line);
                        margin-bottom:12px;">
                        <i class="bi bi-truck" style="color:var(--blue);"></i>
                        <span style="font-size:13px;font-weight:600;color:var(--navy);">ارسال به سراسر ایران</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <i class="bi bi-headset" style="color:var(--blue);"></i>
                        <span style="font-size:13px;font-weight:600;color:var(--navy);">پشتیبانی ۲۴ ساعته</span>
                    </div>
                </div> *@
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        let currentSlide = 0;
        const totalSlides = @Model.ImagesPath.Count;
        const track = document.getElementById('galleryTrack');

        function updateSlider() {
            if (!track) return;
            track.style.transform = `translateX(${currentSlide * 100}%)`;

            const fa = n => n.toString().replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
            const counter = document.getElementById('slideCounter');
            if (counter) counter.textContent = `${fa(currentSlide + 1)} / ${fa(totalSlides)}`;

            for (let i = 0; i < totalSlides; i++) {
                const thumb = document.getElementById(`thumb-${i}`);
                if (thumb) thumb.style.borderColor = i === currentSlide ? 'var(--blue)' : 'var(--line)';
            }
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlider();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlider();
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlider();
        }
    </script>
}