@using Transportation.Buisness.Services.MobileApps.Dtos
@using Transportation.Buisness._0.Common.Paging
@model SPFOutPutDto<MobileAppListResponseDto>

@{
    ViewData["Title"] = "اپلیکیشن‌های موبایل";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div id="main">
    <div class="topbar">
        <div>
            <h1>اپلیکیشن‌های موبایل</h1>
            <p>مدیریت فایل‌های قابل دانلود</p>
        </div>
        <button class="btn btn-primary-navy" id="btnAdd">
            <i class="bi bi-plus-lg ms-1"></i> افزودن اپلیکیشن
        </button>
    </div>

    <div class="card-soft">
        <table class="table table-hover align-middle mb-0" id="appList">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>آیکون</th>
                    <th>نام</th>
                    <th>پلتفرم</th>
                    <th>نسخه</th>
                    <th>حجم</th>
                    <th>وضعیت</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    int row = 1;
                    @foreach (var app in Model.Items)
                    {
                        <tr id="app-@app.Id">
                            <td>@(row++)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(app.IconPath))
                                {
                                    <img src="@Url.Action("GetIcon", new { id = app.Id })"
                                         style="width:40px;height:40px;border-radius:10px;object-fit:cover;">
                                }
                                else
                                {
                                    <div style="width:40px;height:40px;border-radius:10px;
                                        background:var(--blue-100);display:flex;
                                        align-items:center;justify-content:center;">
                                        <i class="bi bi-phone" style="color:var(--blue);"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@app.Title</td>
                            <td>
                                @{
                                    var (icon, color) = app.Platform switch
                                    {
                                        "Android" => ("bi-android2", "#3ddc84"),
                                        "iOS" => ("bi-apple", "#555"),
                                        "Windows" => ("bi-windows", "#0078d4"),
                                        _ => ("bi-phone", "var(--blue)")
                                    };
                                }
                                <i class="bi @icon ms-1" style="color:@color;"></i>
                                @app.Platform
                            </td>
                            <td><span class="badge-cat">@app.Version</span></td>
                            <td class="section-sub">@FormatSize(app.FileSize)</td>
                            <td>
                                @if (app.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">غیرفعال</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-navy js-edit"
                                        data-id="@app.Id"
                                        data-title="@app.Title"
                                        data-description="@app.Description"
                                        data-version="@app.Version"
                                        data-platform="@app.Platform"
                                        data-isactive="@app.IsActive.ToString().ToLower()">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <a href="@Url.Action("Download", new { id = app.Id })"
                                   class="btn btn-sm btn-outline-navy" title="دانلود">
                                    <i class="bi bi-download"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-navy text-danger js-delete"
                                        data-id="@app.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyState">
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-phone fs-3 d-block mb-2 opacity-50"></i>
                            اپلیکیشنی ثبت نشده
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="appModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">اپلیکیشن جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">نام اپلیکیشن</label>
                        <input type="text" class="form-control" id="appTitle"
                               placeholder="مثلاً: اپ راهنگار اندروید">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">پلتفرم</label>
                        <select class="form-select" id="appPlatform">
                            <option value="Android">Android</option>
                            <option value="iOS">iOS</option>
                            <option value="Windows">Windows</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نسخه</label>
                        <input type="text" class="form-control" id="appVersion"
                               placeholder="مثلاً: 1.0.0">
                    </div>
                    <div class="col-md-6 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="appIsActive" checked>
                            <label class="form-check-label" for="appIsActive">فعال</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">توضیحات</label>
                        <textarea class="form-control" id="appDescription" rows="3"
                                  placeholder="ویژگی‌ها و تغییرات این نسخه..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            فایل اپلیکیشن (APK / IPA)
                            <span class="text-danger" id="fileRequired">*</span>
                        </label>
                        <input type="file" class="form-control" id="appFile"
                               accept=".apk,.ipa,.exe,.msi">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">آیکون (اختیاری)</label>
                        <input type="file" class="form-control" id="appIcon" accept="image/*">
                        <div class="mt-2" id="iconPreviewWrap" style="display:none;">
                            <img id="iconPreview"
                                 style="width:48px;height:48px;border-radius:10px;object-fit:cover;">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary-navy" id="saveBtn">ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const AppUrls = {
            create: '@Url.Action("Create")',
            update: '@Url.Action("Update")',
            delete: '@Url.Action("Delete")'
        };

        /* ===== Modal ===== */
        const MobileAppModal = (function() {
            let instance = null;

            function get() {
                if (!instance)
                    instance = new bootstrap.Modal(document.getElementById('appModal'));
                return instance;
            }

            function open(data) {
                debugger;
                $('#editId').val(data?.id || '');
                $('#appTitle').val(data?.title || '');
                $('#appDescription').val(data?.description || '');
                $('#appVersion').val(data?.version || '');
                $('#appPlatform').val(data?.platform || 'Android');
                $('#appIsActive').prop('checked', data ? data.isActive : true);
                $('#appFile').val('');
                $('#appIcon').val('');
                $('#iconPreviewWrap').hide();
                $('#modalTitle').text(data?.id ? 'ویرایش اپلیکیشن' : 'اپلیکیشن جدید');

                // فایل در ویرایش اجباری نیست
                $('#fileRequired').toggle(!data?.id);

                get().show();
            }

            function close() { get().hide(); }

            return { open, close };
        })();

        /* ===== پیش‌نمایش آیکون ===== */
        $('#appIcon').on('change', function() {
            const file = this.files[0];
            if (!file) { $('#iconPreviewWrap').hide(); return; }
            const reader = new FileReader();
            reader.onload = e => {
                $('#iconPreview').attr('src', e.target.result);
                $('#iconPreviewWrap').show();
            };
            reader.readAsDataURL(file);
        });

        /* ===== ذخیره ===== */
        function saveApp() {
            const id = $('#editId').val();
            const isEdit = !!id;
            const title = $('#appTitle').val().trim();
            const file = document.getElementById('appFile').files[0];

            if (!title) { toastr.warning('نام اپلیکیشن الزامی است'); return; }
            if (!isEdit && !file) { toastr.warning('فایل اپلیکیشن الزامی است'); return; }
            if (!$('#appVersion').val().trim()) { toastr.warning('نسخه الزامی است'); return; }
            if (!$('#appDescription').val().trim()) { toastr.warning('توضیحات الزامی است'); return; }

            const formData = new FormData();
            if (isEdit) formData.append('Id', id);
            formData.append('Title', title);
            formData.append('Description', $('#appDescription').val().trim());
            formData.append('Version', $('#appVersion').val().trim());
            formData.append('Platform', $('#appPlatform').val());
            formData.append('IsActive', $('#appIsActive').is(':checked'));

            if (file) formData.append('File', file);
            const icon = document.getElementById('appIcon').files[0];
            if (icon) formData.append('Icon', icon);

            $('#saveBtn').prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm ms-1"></span> در حال ذخیره...');

            $.ajax({
                url: isEdit ? AppUrls.update : AppUrls.create,
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function(xhr) {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) xhr.setRequestHeader('RequestVerificationToken', token);
                },
                success: function() {
                    toastr.success(isEdit ? 'اپلیکیشن ویرایش شد' : 'اپلیکیشن افزوده شد');
                    MobileAppModal.close();
                    setTimeout(() => location.reload(), 800);
                },
                error: function(xhr) {
                    toastr.error(xhr.responseText || 'خطایی رخ داده است');
                },
                complete: function() {
                    $('#saveBtn').prop('disabled', false).text('ذخیره');
                }
            });
        }

        /* ===== حذف ===== */
        function deleteApp(id) {
            Swal.fire({
                title: 'حذف اپلیکیشن',
                text: 'این اپلیکیشن برای همیشه حذف می‌شود. آیا مطمئن هستید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true,
                customClass: { popup: 'swal-rtl' }
            }).then(result => {
                if (!result.isConfirmed) return;
                AppAjax.delete(`${AppUrls.delete}?id=${id}`)
                    .then(() => {
                        toastr.success('اپلیکیشن حذف شد');
                        $(`#app-${id}`).fadeOut(300, function() {
                            $(this).remove();
                            checkEmptyState();
                        });
                    })
                    .catch(() => { });
            });
        }

        function checkEmptyState() {
            if ($('#appList tbody tr').length === 0) {
                $('#appList tbody').html(`
                        <tr id="emptyState">
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-phone fs-3 d-block mb-2 opacity-50"></i>
                                اپلیکیشنی ثبت نشده
                            </td>
                        </tr>`);
            }
        }

        /* ===== Event Binding ===== */
        $(function() {
            $('#btnAdd').on('click', () => MobileAppModal.open());
            $('#saveBtn').on('click', saveApp);

            $(document).on('click', '.js-edit', function() {

                const isActive = $(this).data('isactive');

                MobileAppModal.open({
                    id: $(this).data('id'),
                    title: $(this).data('title'),
                    description: $(this).data('description'),
                    version: $(this).data('version'),
                    platform: $(this).data('platform'),
                    isActive: isActive === true || isActive === 'true'
                });
            });

            $(document).on('click', '.js-delete', function() {
                deleteApp($(this).data('id'));
            });
        });
    </script>
}

@functions {
    string FormatSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes} B";
    }
}