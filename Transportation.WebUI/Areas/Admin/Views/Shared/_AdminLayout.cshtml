<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل مدیریت محصولات | ناوگان و GPS</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css">
    <link rel="stylesheet" href="~/css/toastr.min.css">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/quill.snow.min.css" />

    <style>
            #main {
                padding-bottom: 52px;
            }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div id="sidebar">
        <div class="brand d-flex align-items-center gap-2">
            <div class="brand-mark route-pattern">
                <i class="bi bi-geo-alt-fill" style="color:#fff;font-size:1.2rem;"></i>
            </div>
            <div>
                @* <div class="brand-title">پنل مدیریت</div> *@
                <div class="brand-sub">ناوگان و ردیابی GPS</div>
            </div>
        </div>
        <nav>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                <i class="bi bi-house-fill"></i><span>صفحه اصلی</span>
            </a>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link">
                <i class="bi bi-grid-1x2-fill"></i><span>داشبورد</span>
            </a>
            <a asp-area="Admin" asp-controller="ProductCategory" asp-action="Index" class="nav-link">
                <i class="bi bi-tags-fill"></i><span>دسته‌بندی محصولات</span>
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="nav-link">
                <i class="bi bi-box-seam-fill"></i><span>محصولات</span>
            </a>
            <a asp-area="Admin" asp-controller="AboutUs" asp-action="Index" class="nav-link">
                <i class="bi bi-building-fill"></i><span>معرفی شرکت</span>
            </a>
            <a asp-area="Admin" asp-controller="MobileApp" asp-action="Index" class="nav-link">
                <i class="bi bi-phone-fill"></i><span>اپ موبایل</span>
            </a>
        </nav>


        <form asp-area="Admin" asp-controller="Home" asp-action="Logout" method="post"
              style="padding:12px 16px;border-top:1px solid rgba(255,255,255,.07);">
            <button type="submit"
                    style="display:flex;align-items:center;justify-content:center;gap:8px;
                width:100%;background:transparent;border:1px solid rgba(255,255,255,.15);
                border-radius:10px;padding:10px 14px;color:rgba(255,255,255,.7);
                font-family:inherit;font-size:13px;font-weight:500;
                cursor:pointer;transition:.2s;"
                    onmouseover="this.style.borderColor='rgba(220,53,69,.6)';this.style.color='#e74c3c'"
                    onmouseout="this.style.borderColor='rgba(255,255,255,.15)';this.style.color='rgba(255,255,255,.7)'">
                <i class="bi bi-box-arrow-left"></i>
                <span>خروج از پنل</span>
            </button>
        </form>
    </div>
    @RenderBody()
    <!-- PRODUCT MODAL -->
    <div class="modal fade" id="productModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;border:none;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="productModalTitle">محصول جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="productForm">
                        <input type="hidden" id="prodId">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label">نام محصول</label>
                                <input type="text" class="form-control" id="prodName" required>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">دسته‌بندی</label>
                                <select class="form-select" id="prodCategory" required></select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">قیمت (اختیاری)</label>
                                <input type="text" class="form-control" id="prodPrice" placeholder="مثلاً: ۲٬۵۰۰٬۰۰۰ تومان">
                            </div>
                            <div class="col-12">
                                <label class="form-label">توضیحات محصول</label>
                                <textarea class="form-control" id="prodDesc" rows="3"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">تصاویر محصول</label>
                                <input type="file" accept="image/*" multiple class="form-control" id="prodImages">
                                <div class="thumb-strip" id="prodThumbs"></div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-primary-navy" onclick="saveProduct()">ذخیره محصول</button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div class="toast-container save-toast">
        <div id="saveToast" class="toast align-items-center text-white border-0" role="alert" style="background:var(--navy-900);">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle-fill ms-1"></i> <span id="toastMsg">ذخیره شد</span></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="~/js/jquery-4.0.0.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toastr.min.js"></script>
    <script src="~/js/ajax-helper.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="~/js/quill.min.js"></script>

    @RenderSection("Scripts", required: false)

    <footer style="position:fixed;bottom:0;right:260px;left:0;z-index:50;
        background:linear-gradient(180deg, var(--navy-900) 0%, var(--navy-800) 100%);
        padding:10px 24px;display:flex;align-items:center;
        justify-content:space-between;gap:16px;
        border-top:1px solid rgba(255,255,255,.07);">
        <div style="color:rgba(255,255,255,.7);font-size:12px;font-weight:500;">
            طراحی و توسعه توسط
            <span style="color:#fff;font-weight:700;">تیم همتاگستر رایانه بیشاپور</span>
        </div>
        <div style="display:flex;gap:12px;">
            <a href="tel:09178237255"
               style="display:flex;align-items:center;gap:6px;color:#fff;
                font-size:12.5px;text-decoration:none;font-weight:600;">
                <i class="bi bi-telephone-fill"></i>
                09178237255
            </a>
            <span style="color:rgba(255,255,255,.3);">|</span>
            <a href="tel:09177178651"
               style="display:flex;align-items:center;gap:6px;color:#fff;
                font-size:12.5px;text-decoration:none;font-weight:600;">
                <i class="bi bi-telephone-fill"></i>
                09177178651
            </a>
        </div>
    </footer>
</body>
</html>
