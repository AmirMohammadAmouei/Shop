@using Transportation.Buisness.Services.CompanyFeatures.Dtos
@using Transportation.Buisness._0.Common.Paging
@model SPFOutPutDto<CompanyFeatureListResponseDto>

<div id="main">
    <div class="topbar">
        <div>
            <h1>دسته‌بندی محصولات</h1>
            <p>مدیریت دسته‌بندی‌های محصولات</p>
        </div>
        <button class="btn btn-primary-navy" id="btnAddFeature">
            <i class="bi bi-plus-lg ms-1"></i> دسته‌بندی جدید
        </button>
    </div>

    <div class="p-4">
        <table class="table table-bordered table-hover align-middle" id="featureList">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>نام دسته‌بندی</th>
                    <th class="text-center" style="width: 140px;">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {

                    int row = 1;
                    @foreach (var feature in Model.Items)
                    {
                        <tr id="feature-@feature.Id">
                            <td>@(row++)</td>
                            <td class="fw-semibold">@feature.Title</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-navy js-edit-feature"
                                        data-id="@feature.Id"
                                        data-title="@feature.Title"
                                        data-description="@feature.Description"
                                        data-sortorder="@feature.SortOrder"
                                        data-isactive="@feature.IsActive.ToString().ToLower()">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-navy text-danger js-delete-feature"
                                        data-id="@feature.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyState">
                        <td colspan="3" class="text-center text-muted py-4">
                            <i class="bi bi-tags fs-4 d-block mb-2"></i>
                            مزایایی ثبت نشده
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="featureModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">دسته‌بندی جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" name="id">
                <div class="mb-3">
                    <label class="form-label">نام عنوان</label>
                    <input type="text" class="form-control" id="title" placeholder="مثلا: گزارش گیری پیشرفته">
                </div>

                <div class="mb-3">
                    <label class="form-label">توضیحات</label>
                    <textarea type="text" class="form-control" id="description" placeholder="توضیحات">
                </textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">ترتیب نمایش</label>
                    <input type="number" class="form-control" id="sortOrder" placeholder="ترتیب نمایش">
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="isActive" role="switch">
                        <label class="form-check-label" for="isActive">فعال</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary-navy" id="saveBtn">ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ========================================================
           بخش ۱: تنظیمات و مسیرها
           ======================================================== */
        const FeatureUrls = {
            create: '@Url.Action("Create")',
            update: '@Url.Action("Update")',
            delete: '@Url.Action("Delete")'
        };

        /* ========================================================
           بخش ۲: منطق مدیریت Modal (باز کردن / پر کردن فرم)
           ======================================================== */
        const FeatureModal = (function () {
            debugger;
            let instance = null;

            function get() {
                if (!instance) {
                    instance = new bootstrap.Modal(document.getElementById('featureModal'));
                }
                return instance;
            }

            function open(data) {
                data= data || {},
                $('#editId').val(data.id || '');
                $('#title').val(data.title || '');
                $('#description').val(data.description || '');
                $('#sortOrder').val(data.sortOrder || 0);
                $('#isActive').val(data.isActive || '');
                $('#modalTitle').text(data.id ? 'ویرایش دسته‌بندی' : 'دسته‌بندی جدید');
                get().show();
            }

            function close() {
                get().hide();
            }

            return { open, close };
        })();

        /* ========================================================
           بخش ۳: عملیات ذخیره (Create / Update)
           ======================================================== */
        function saveFeature() {
            debugger;
            const id = $('#editId').val();
            const title = $('#title').val().trim();
            const description = $('#description').val().trim();
            const sortOrder = $('#sortOrder').val() || 0;
            const isActive = $('#isActive').is(':checked');


            if (!title) {
                toastr.warning('نام دسته‌بندی الزامی است');
                return;
            }
            const isEdit = !!id;
            const url = isEdit ? `${FeatureUrls.update}?id=${id}` : FeatureUrls.create;
            const data = isEdit ? { id: id, title: title, description: description, sortOrder: sortOrder, isActive: isActive } : 
            { title: title, description: description, sortOrder: sortOrder, isActive: isActive };
            
            AppAjax.post(url, data, { loadingTarget: '#saveBtn' })
                .then(() => {
                    toastr.success(isEdit ? 'مزایا ویرایش شد' : 'مزایا افزوده شد');
                    FeatureModal.close();
                    setTimeout(() => location.reload(), 800);
                })
                .catch(() => {
                    // پیام خطا از قبل توسط AppAjax نمایش داده شده
                });
        }

        /* ========================================================
           بخش ۴: عملیات حذف
           ======================================================== */
        function deleteFeature(id) {
            Swal.fire({
                title: 'حذف مزایا',
                text: 'این مزایا حذف می‌شود. آیا مطمئن هستید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true,
                customClass: { popup: 'swal-rtl' }
            }).then((result) => {
                if (!result.isConfirmed) return;

                AppAjax.post(`${FeatureUrls.delete}?id=${id}`)
                    .then(() => {
                        toastr.success('مزایا حذف شد');
                        $(`#feature-${id}`).fadeOut(300, function () {
                            $(this).remove();
                            checkEmptyState();
                        });
                    })
                    .catch(() => {
                        // پیام خطا از AppAjax نمایش داده شده
                    });
            });
        }

        // بعد از حذف آخرین ردیف، پیام "خالی" رو نشون بده
        function checkEmptyState() {
            if ($('#featureList tbody tr').length === 0) {
                $('#featureList tbody').html(`
                                            <tr id="emptyState">
                                                <td colspan="3" class="text-center text-muted py-4">
                                                    <i class="bi bi-tags fs-4 d-block mb-2"></i>
                                                    مزایایی ثبت نشده
                                                </td>
                                            </tr>
                                        `);
            }
        }

        /* ========================================================
           بخش ۵: اتصال رویدادها (Event Binding)
           ======================================================== */
        $(function () {
            debugger;
            $('#btnAddFeature').on('click', () =>FeatureModal.open());

            $('#saveBtn').on('click', saveFeature);

            $(document).on('click', '.js-edit-feature', function () {
                debugger;
                FeatureModal.open({
                    id: $(this).data('id'),
                    title:$(this).data('title'),
                    description:$(this).data('description'),
                    sortOrder:$(this).data('sortOrder'),
                    isActive :$(this).data('isActive')
                });
            });

            $(document).on('click', '.js-delete-feature', function () {
                deleteFeature($(this).data('id'));
            });
        });
    </script>
}