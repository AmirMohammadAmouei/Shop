@using Transportation.Buisness.Services.Products.Dto
@using Transportation.Buisness.Services.ProductCategories.Dto
@using Transportation.Buisness._0.Common.Paging
@model SPFOutPutDto<ProductListResponseDto>

@{
    ViewData["Title"] = "محصولات";
    var categories = ViewBag.Categories as List<ProductCategoryListResponseDto> ?? new();
}

<style>
    #prodDescriptionEditor .ql-editor {
        direction: rtl;
        text-align: right;
    }

        #prodDescriptionEditor .ql-editor.ql-blank::before {
            right: 15px;
            left: unset;
            text-align: right;
        }
</style>

<div id="main">
    <div class="topbar">
        <div>
            <h1>محصولات</h1>
            <p>مدیریت محصولات</p>
        </div>
        <button class="btn btn-primary-navy" id="btnAddProduct">
            <i class="bi bi-plus-lg ms-1"></i> محصول جدید
        </button>
    </div>

    <div class="p-4">
        <table class="table table-bordered table-hover align-middle" id="productList">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>تصویر</th>
                    <th>نام محصول</th>
                    <th>دسته‌بندی</th>
                    <th>قیمت</th>
                    <th class="text-center" style="width:140px;">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    int row = 1;
                    @foreach (var product in Model.Items)
                    {
                        <tr id="product-@product.Id">
                            <td>@(row++)</td>
                            <td>
                                @if (product.Images.Any())
                                {
                                    <img src="@product.Images.First().Path"
                                         style="width:48px;height:48px;object-fit:cover;border-radius:8px;">
                                }
                                else
                                {
                                    <i class="bi bi-image text-muted fs-4"></i>
                                }
                            </td>
                            <td class="fw-semibold">@product.Name</td>
                            <td>@product.CategoryName</td>
                            <td>
                                @if (product.ShowPrice)
                                {
                                    @product.Price.ToString("N0")
                                    <small class="ms-1">تومان</small>
                                }
                                else
                                {
                                    <span class="text-muted">تماس بگیرید</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-navy js-edit-product"
                                        data-id="@product.Id"
                                        data-name="@product.Name"
                                        data-description="@product.Description"
                                        data-price="@product.Price"
                                        data-showprice="@product.ShowPrice.ToString().ToLower()"
                                        data-categoryid="@product.ProductCategoryId"
                                        data-images="@System.Text.Json.JsonSerializer.Serialize(product.Images)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-navy text-danger js-delete-product"
                                        data-id="@product.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyState">
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-box-seam fs-4 d-block mb-2"></i>
                            محصولی ثبت نشده
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">محصول جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">نام محصول</label>
                        <input type="text" class="form-control" id="prodName">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">دسته‌بندی</label>
                        <select class="form-select" id="prodCategory">
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">قیمت (تومان)</label>
                        <input type="number" class="form-control" id="prodPrice" min="0">
                    </div>
                    <div class="col-md-6 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="prodShowPrice">
                            <label class="form-check-label" for="prodShowPrice">نمایش قیمت</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">توضیحات</label>
                        <div id="prodDescriptionEditor"
                             style="height:160px; border-radius:10px; background:#fff;
                            font-family:'Vazirmatn',sans-serif; direction:rtl;">
                        </div>
                        <input type="hidden" id="prodDescription">
                    </div>
                    <div class="col-12">
                        <label class="form-label">تصاویر محصول</label>
                        <input type="file" class="form-control" id="prodImages" accept="image/*" multiple>
                        <div class="d-flex flex-wrap gap-2 mt-3" id="imagePreviewContainer"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary-navy" id="saveBtn">ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ProductUrls = {
            create: '@Url.Action("Create")',
            update: '@Url.Action("Update")',
            delete: '@Url.Action("Delete")',
            download: '@Url.Action("DownloadImage")',
            getDetails: '@Url.Action("GetDetails")'
        };


        const quill = new Quill('#prodDescriptionEditor', {
            theme: 'snow',
            placeholder: 'توضیحات محصول را وارد کنید...',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        });

        let selectedFiles = [];

        /* ===== Modal ===== */
        const ProductModal = (function () {
            let instance = null;
            let deletedImageIds = [];

            function get() {
                if (!instance)
                    instance = new bootstrap.Modal(document.getElementById('productModal'));
                return instance;
            }

            function open(data) {
                console.log('open data:', data);
                console.log('data.id:', data?.id);
                deletedImageIds = [];
                selectedFiles = [];
                $('#editId').val(data?.id || '');
                $('#prodName').val(data?.name || '');
                $('#prodPrice').val(data?.price || '');
                $('#prodShowPrice').prop('checked', data?.showPrice || false);
                $('#modalTitle').text(data?.id ? 'ویرایش محصول' : 'محصول جدید');
                $('#prodImages').val('');

                if (data?.description) {
                    quill.root.innerHTML = data.description;
                } else {
                    quill.setText('');
                }

                const container = $('#imagePreviewContainer').empty();
                if (data?.images?.length) {
                    data.images.forEach(img => {
                        container.append(existingThumb(img.id, img.path));
                    });
                }

                get().show();
                setTimeout(() => $('#prodCategory').val(data?.categoryId || ''), 100);
            }

            function close() { get().hide(); }
            function getDeletedIds() { return deletedImageIds; }
            function addDeletedId(id) { deletedImageIds.push(id); }

            return { open, close, getDeletedIds, addDeletedId };
        })();

        /* ===== پیش‌نمایش عکس‌های موجود ===== */
        function existingThumb(id, path) {
            return $(`
                        <div class="position-relative" style="width:80px;height:80px;" id="img-${id}">
                            <img src="${path}"
                                 style="width:80px;height:80px;object-fit:cover;
                                        border-radius:8px;border:1px solid #dee2e6;">
                            <button type="button" onclick="removeExistingImage(${id})"
                                    style="position:absolute;top:-6px;left:-6px;width:20px;height:20px;
                                           border-radius:50%;background:#dc3545;border:none;
                                           color:#fff;font-size:12px;line-height:1;padding:0;">×</button>
                        </div>`);
        }

        function removeExistingImage(id) {
            ProductModal.addDeletedId(id);
            $(`#img-${id}`).fadeOut(200, function () { $(this).remove(); });
        }
        $('#prodImages').on('change', function () {
            const newFiles = Array.from(this.files);
            newFiles.forEach((file, idx) => {
                if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                    selectedFiles.push(file);
                    const reader = new FileReader();
                    reader.onload = e => {
                        const fileIdx = selectedFiles.length - 1;
                        $('#imagePreviewContainer').append(`
                                            <div class="new-preview position-relative" style="width:80px;height:80px;" id="new-img-${fileIdx}">
                                                <img src="${e.target.result}"
                                                     style="width:80px;height:80px;object-fit:cover;
                                                            border-radius:8px;border:1px solid #dee2e6;">
                                                <button type="button" onclick="removeNewImage(${fileIdx})"
                                                        style="position:absolute;top:-6px;left:-6px;width:20px;height:20px;
                                                               border-radius:50%;background:#dc3545;border:none;
                                                               color:#fff;font-size:12px;line-height:1;padding:0;">×</button>
                                            </div>`);
                    };
                    reader.readAsDataURL(file);
                }
            });
            this.value = '';
        });

        function removeNewImage(idx) {
            selectedFiles.splice(idx, 1);
            $(`#new-img-${idx}`).remove();
            $('#imagePreviewContainer .new-preview').each((i, el) => {
                $(el).attr('id', `new-img-${i}`);
                $(el).find('button').attr('onclick', `removeNewImage(${i})`);
            });
        }
        /* ===== ذخیره ===== */
        function saveProduct() {
            const id = $('#editId').val();
            const isEdit = !!id;
            const name = $('#prodName').val().trim();
            const categoryId = $('#prodCategory').val();
            document.getElementById('prodDescription').value = quill.root.innerHTML;
            const descText = quill.getText().trim();
            const description = descText.length > 0 ? quill.root.innerHTML : '';

            if (!name) { toastr.warning('نام محصول الزامی است'); return; }
            if (!categoryId) { toastr.warning('دسته‌بندی الزامی است'); return; }

            const formData = new FormData();
            if (isEdit) formData.append('Id', id);
            formData.append('Name', name);
            formData.append('Description', description);

            // formData.append('Description', $('#prodDescription').val().trim());
            formData.append('Price', $('#prodPrice').val() || 0);
            formData.append('ShowPrice', $('#prodShowPrice').is(':checked'));
            formData.append('ProductCategoryId', categoryId);

            const files = document.getElementById('prodImages').files;
            const imageKey = isEdit ? 'NewImages' : 'Images';
            
            selectedFiles.forEach(file => formData.append(imageKey, file));


            ProductModal.getDeletedIds().forEach(imgId =>
                formData.append('DeletedImageIds', imgId));

            $('#saveBtn').prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm ms-1"></span> در حال ذخیره...');

            $.ajax({
                url: isEdit ? ProductUrls.update : ProductUrls.create,
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function (xhr) {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    if (token) xhr.setRequestHeader('RequestVerificationToken', token);
                },
                success: function () {
                    toastr.success(isEdit ? 'محصول ویرایش شد' : 'محصول افزوده شد');
                    ProductModal.close();
                    setTimeout(() => location.reload(), 800);
                },
                error: function (xhr) {
                    toastr.error(xhr.responseText || 'خطایی رخ داده است');
                },
                complete: function () {
                    $('#saveBtn').prop('disabled', false).text('ذخیره');
                }
            });
        }

        /* ===== حذف ===== */
        function deleteProduct(id) {
            Swal.fire({
                title: 'حذف محصول',
                text: 'این محصول برای همیشه حذف می‌شود. آیا مطمئن هستید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true,
                customClass: { popup: 'swal-rtl' }
            }).then(result => {
                if (!result.isConfirmed) return;
                AppAjax.delete(`${ProductUrls.delete}?id=${id}`)
                    .then(() => {
                        toastr.success('محصول حذف شد');
                        $(`#product-${id}`).fadeOut(300, function () {
                            $(this).remove();
                            checkEmptyState();
                        });
                    })
                    .catch(() => { });
            });
        }

        function checkEmptyState() {
            if ($('#productList tbody tr').length === 0) {
                $('#productList tbody').html(`
                                        <tr id="emptyState">
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="bi bi-box-seam fs-4 d-block mb-2"></i>
                                                محصولی ثبت نشده
                                            </td>
                                        </tr>`);
            }
        }

        /* ===== Event Binding ===== */
        $(function () {
            $('#btnAddProduct').on('click', () => ProductModal.open());
            $('#saveBtn').on('click', saveProduct);

            $(document).on('click', '.js-edit-product', function () {
                const id = $(this).data('id');
                console.log('clicked id:', id);
                console.log('getDetails url:', ProductUrls.getDetails);
                AppAjax.get(`${ProductUrls.getDetails}?id=${id}`)
                    .then(data => {
                        console.log('product data:', data);
                        ProductModal.open({
                            id: id,
                            name: data.name,
                            description: data.description,
                            price: data.price,
                            showPrice: data.showPrice,
                            categoryId: data.productCategoryId,
                            images: data.imagesPath
                        });
                    })
                    .catch(() => { });
            });

            $(document).on('click', '.js-delete-product', function () {
                deleteProduct($(this).data('id'));
            });
        });
    </script>
}